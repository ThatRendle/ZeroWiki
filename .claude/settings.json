{
  "permissions": {
    "allow": [
      "mcp__roslyn-codelens__*",
      "Bash(make build)",
      "Bash(make test)",
      "Bash(make format)",
      "Bash(make validate)",
      "Bash(make gates)",
      "Bash(make changes)"
    ]
  },
  "enabledPlugins": {},
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "^(worker|worker-.+|reviewer|supervisor)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/dmons-tripwire.sh\" start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(worker|worker-.+|reviewer|supervisor)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/dmons-tripwire.sh\" stop"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/dmons-tripwire.sh\" report"
          }
        ]
      }
    ]
  }
}
